# Supabase Database Configuration
# Rename this file to .env or set these environment variables in your system
# to connect your Spring Boot application to Supabase.

SUPABASE_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_USERNAME=postgres
SUPABASE_PASSWORD=your_supabase_database_password
